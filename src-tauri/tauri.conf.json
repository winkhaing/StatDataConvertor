{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatData Converter",
  "version": "0.10.0",
  "identifier": "org.statdata.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StatData Converter",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/statdata-engine"],
    "resources": [
      "../LICENSE",
      "../THIRD_PARTY_NOTICES.md",
      "../licenses/JMPReader-MIT.txt"
    ],
    "category": "Utility",
    "shortDescription": "Private statistical data conversion",
    "longDescription": "Convert statistical datasets locally and receive a transparent fidelity report.",
    "copyright": "Copyright 2026 StatData Converter contributors",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
