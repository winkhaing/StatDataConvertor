{
  "protocol_version": 1,
  "name": "StatData SAS Data Bridge",
  "executable": "./__EXECUTABLE__",
  "arguments": ["--format", "sas_data"],
  "timeout_seconds": 600,
  "format": {
    "id": "sas_data",
    "family": "SAS",
    "label": "SAS data file",
    "extensions": [".sas7bdat"],
    "can_read": true,
    "can_write": true,
    "trust": "experimental",
    "metadata_features": [
      "dataset_label",
      "column_labels",
      "value_labels",
      "formats"
    ]
  }
}
