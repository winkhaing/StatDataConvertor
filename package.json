{
  "name": "statdata-converter",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run engine:bundle && tauri build",
    "engine:setup": "uv sync --project engine --all-extras",
    "engine:test": "uv run --project engine pytest",
    "engine:bundle": "node scripts/build-sidecar.mjs",
    "bridge:jmp:build": "node scripts/build-jmp-bridge.mjs",
    "bridge:sas:build": "node scripts/build-sas-bridge.mjs",
    "bridge:windows-com:build": "node scripts/build-windows-com-bridges.mjs",
    "release:check-version": "node scripts/check-release-version.mjs",
    "release:smoke-package": "node scripts/smoke-test-package.mjs",
    "release:package-bridges": "node scripts/package-bridge-bundles.mjs",
    "release:manifest": "node scripts/write-artifact-manifest.mjs",
    "release:verify": "node scripts/verify-artifact-manifest.mjs",
    "release:upload-evidence": "node scripts/upload-release-evidence.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^27.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  }
}
